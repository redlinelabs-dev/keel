{
  "_comment": [
    "Security policy for keel's guard hook. Ships WITH the plugin so it cannot go",
    "missing or drift from the code that reads it \u2014 the failure mode of keeping",
    "policy in a separate tree.",
    "Patterns are JS regex strings, matched case-insensitively against the Bash",
    "command AFTER heredoc-data removal and env-prefix stripping.",
    "Tiers: blocked = exit 2 (hard stop) | confirm = ask the user | alert = log and allow.",
    "Path globs: `*` matches within one path segment, `**` crosses separators.",
    "Use `**` whenever the intent is 'this directory and everything under it' \u2014",
    "`~/.ssh/*` leaves ~/.ssh/keys/id_rsa unprotected.",
    "paths.noDelete is enforced for Bash deletion commands only (rm/rmdir/shred/",
    "unlink/srm naming the path, or naming a directory that contains it).",
    "Derived from PAI's patterns.yaml (Daniel Miessler's PAI, MIT), converted",
    "mechanically rather than retyped."
  ],
  "version": "1.0",
  "bash": {
    "blocked": [
      {
        "pattern": ":\\(\\)\\s*\\{\\s*:\\s*\\|\\s*(?::\\s*)?(?:&\\s*)?\\}\\s*;\\s*:",
        "reason": "Fork bomb (self-replicating process exhaustion)"
      },
      {
        "pattern": "\\brm(?=(?:\\s+-{1,2}[a-zA-Z][\\w-]*)*?\\s+(?:-[a-qs-zA-QS-Z]*r[a-zA-Z]*|--recursive)\\b)(?=(?<o>(?:\\s+-{1,2}[a-zA-Z][\\w-]*)*))\\k<o>\\s+(?:/|~|\\$HOME|\\$\\{HOME\\}|/\\*|~/\\*|/home/[^\\s/'\"]+/?|/Users/[^\\s/'\"]+/?)(?=\\s|;|&|\\||'|\"|`|\\)|$)",
        "reason": "Recursive delete of filesystem root or home directory"
      },
      {
        "pattern": "\\brm(?=(?:\\s+-{1,2}[a-zA-Z][\\w-]*)*?\\s+(?:-[a-qs-zA-QS-Z]*r[a-zA-Z]*|--recursive)\\b)(?=(?<o>(?:\\s+-{1,2}[a-zA-Z][\\w-]*)*))\\k<o>\\s+/(?:etc|usr|var|bin|boot|lib|sbin|sys|proc|dev|root)(?=\\s|/|;|&|\\||'|\"|`|\\)|$)",
        "reason": "Recursive delete of a critical system directory"
      },
      {
        "pattern": "\\bfind\\s+(?:/|~|\\$HOME)(?:\\s|$)[^\\n]*-(?:delete\\b|exec\\s+(?:sudo\\s+)?rm\\b)",
        "reason": "Mass delete via find over the filesystem root or home directory"
      },
      {
        "pattern": "\\bmkfs(?:\\.\\w+)?\\s+",
        "reason": "Filesystem format (destroys all data on target)"
      },
      {
        "pattern": "\\bdd\\b[^\\n]*\\bof=/dev/(?:sd|nvme|hd|vd|mmcblk|disk|xvd)",
        "reason": "Raw write to a block device (disk destruction)"
      },
      {
        "pattern": "(?:^|\\s)>\\s*/dev/(?:sd|nvme|hd|vd|mmcblk)",
        "reason": "Shell redirect overwriting a raw block device"
      },
      {
        "pattern": "\\bwipefs\\b",
        "reason": "Wipes filesystem signatures from a device"
      },
      {
        "pattern": "(?<=(?:^|[;&|(\\n`]|\\$\\(|\\bssh\\b[^\\n;&|]{0,200}\\s['\"])[ \\t]{0,16}(?:(?:sudo|command|exec|busybox|nohup|time)[ \\t]{1,16}(?:-\\S{1,32}[ \\t]{1,16}){0,8}){0,4})(?:(?:/usr)?(?:/local)?/s?bin/)?(?:printenv|env)\\s*(?:\\||>|$)",
        "reason": "Looks like an environment dump: env or printenv where a command starts, right before |, > or the end of the command. Rewrite and retry: in a search pattern write [e]nv and print[e]nv (process\\.[e]nv, Bun\\.[e]nv, ls | grep -E 'tok|[e]nv'). To read one variable, name it: printf '%s\\n' \"$HOME\". To list variable names without values, in bash: compgen -e. Never dump the environment."
      }
    ],
    "confirm": [
      {
        "pattern": "\\b(?:curl|wget)\\b[^|]*\\|\\s*(?:sudo\\s+)?(?:sh|bash|zsh)\\b(?!(?:\\s+-[a-z]+)*\\s+-[a-z]*c)",
        "reason": "Piping a remote script directly into a shell (remote code execution)"
      },
      {
        "pattern": "\\b(?:curl|wget)\\b[^|]*\\|\\s*(?:sudo\\s+)?python[0-9.]*\\b(?!(?:\\s+-[a-z]+)*\\s+-[a-z]*[cm]|(?:\\s+-[a-z]+)*\\s+[^\\s\\-;&|)])",
        "reason": "Piping a remote script directly into a shell (remote code execution)"
      },
      {
        "pattern": "\\b(?:curl|wget)\\b[^|]*\\|\\s*(?:sudo\\s+)?perl\\b(?!(?:\\s+-[a-z]+)*\\s+-[a-z]*e|(?:\\s+-[a-z]+)*\\s+[^\\s\\-;&|)])",
        "reason": "Piping a remote script directly into a shell (remote code execution)"
      },
      {
        "pattern": "(?:^|\\n)(?:(?!\\b(?:curl|wget)\\b)[^\\n])*\\b(?:curl|wget)\\b(?:(?!\\s[\\\"']?(?:-d|--data|--json|-T|--upload-file|(?:-F[\\\"']?[ \\t]*|--form(?:-string)?(?:=|[ \\t]+))(?=(?![\\\"']?[a-z][\\w+.-]*://)(?:\\\"[^\\\"=\\n]*\\\"|'[^'=\\n]*'|\\([^()=\\n]*\\)|\\\\[^\\n]|[^\\s\\\"'=\\\\(])*(?:[\\\"'][^\\\"'=\\n]*)?=)|--post-(?:data|file)|--body-(?:data|file)))[^\\n])*\\s[\\\"']?(?:-d|--data|--json|-T|--upload-file|(?:-F[\\\"']?[ \\t]*|--form(?:-string)?(?:=|[ \\t]+))(?=(?![\\\"']?[a-z][\\w+.-]*://)(?:\\\"[^\\\"=\\n]*\\\"|'[^'=\\n]*'|\\([^()=\\n]*\\)|\\\\[^\\n]|[^\\s\\\"'=\\\\(])*(?:[\\\"'][^\\\"'=\\n]*)?=)|--post-(?:data|file)|--body-(?:data|file))[^\\n]*(?:\\.env|id_rsa|id_ed25519|\\.aws/credentials|\\.ssh/|secret|token|password|\\.pem)",
        "reason": "Possible credential exfiltration over HTTP"
      },
      {
        "pattern": "(?:^|\\n)(?:(?!\\b(?:cat|less|head|tail|base64)\\b)[^\\n])*\\b(?:cat|less|head|tail|base64)\\b(?:(?!(?:\\.env|id_rsa|id_ed25519|\\.aws/credentials|\\.ssh/id_|\\.pem))[^\\n])*(?:\\.env|id_rsa|id_ed25519|\\.aws/credentials|\\.ssh/id_|\\.pem)[^|\\n]*\\|[^\\n]*\\b(?:curl|wget|nc|ncat|socat)\\b",
        "reason": "Reading a secret file and piping it to the network"
      },
      {
        "pattern": "(?:^|\\n)(?:(?!\\b(?:scp|rsync)\\b)[^\\n])*\\b(?:scp|rsync)\\b(?:(?!(?:\\.env|id_rsa|\\.aws/credentials|\\.ssh/id_))[^\\n])*(?:\\.env|id_rsa|\\.aws/credentials|\\.ssh/id_)[^\\n]*\\s[^\\s@]+@\\S+:",
        "reason": "Copying secrets to a remote host"
      },
      {
        "pattern": "\\bgit(?=(?<g>(?:\\s+(?:(?:-C|-c|--git-dir|--work-tree|--namespace|--super-prefix|--config-env|--attr-source|--shallow-file)\\s+(?:\\\"[^\\\"]*\\\"|'[^']*'|\\\\.|[^\\s\\\"'\\\\-])(?:\\\"[^\\\"]*\\\"|'[^']*'|\\\\.|[^\\s\\\"'\\\\])*|-{1,2}[^\\s=-][^\\s=]*(?:=(?:\\\"[^\\\"]*\\\"|'[^']*'|\\\\.|[^\\s\\\"'\\\\])*)?))*))\\k<g>\\s+push\\b[^\\n;&|]*(?:--force\\b|(?:^|\\s)-[a-eg-z]*f[a-z]*\\b|\\s[\\\"']?\\+[\\w/.@-])",
        "reason": "Force-push rewrites remote history (protect shared and protected remotes)"
      },
      {
        "pattern": "\\bchmod\\s+(?:-[a-zA-Z]+\\s+)*0?777\\b",
        "reason": "World-writable permissions (recursive if -R)"
      },
      {
        "pattern": "(?:^|\\n)(?:(?!\\b(?:curl|wget)\\b)[^\\n])*\\b(?:curl|wget)\\b(?:(?!\\s[\\\"']?(?:-T\\s|--upload-file[\\s=]|--data(?:-binary|-raw|-urlencode)?[\\s=]+[\\\"']?@|-d\\s*[\\\"']?@|(?:-F[\\\"']?[ \\t]*|--form(?:=|[ \\t]+))(?![\\\"']?[a-z][\\w+.-]*://)(?:\\\"[^\\\"=\\n]*\\\"|'[^'=\\n]*'|\\([^()=\\n]*\\)|\\\\[^\\n]|[^\\s\\\"'=\\\\(])*(?:[\\\"'][^\\\"'=\\n]*)?=[\\\"']?\\\\?[@<]|--(?:post|body)-file[\\s=]))[^\\n])*\\s[\\\"']?(?:-T\\s|--upload-file[\\s=]|--data(?:-binary|-raw|-urlencode)?[\\s=]+[\\\"']?@|-d\\s*[\\\"']?@|(?:-F[\\\"']?[ \\t]*|--form(?:=|[ \\t]+))(?![\\\"']?[a-z][\\w+.-]*://)(?:\\\"[^\\\"=\\n]*\\\"|'[^'=\\n]*'|\\([^()=\\n]*\\)|\\\\[^\\n]|[^\\s\\\"'=\\\\(])*(?:[\\\"'][^\\\"'=\\n]*)?=[\\\"']?\\\\?[@<]|--(?:post|body)-file[\\s=])",
        "reason": "Uploading a local file over HTTP (possible data exfiltration)"
      },
      {
        "pattern": "\\bgh\\s+(?:gist\\s+create|pr\\s+create)\\b",
        "reason": "Publishing local content to GitHub (gist/PR) \u2014 confirm intended"
      },
      {
        "pattern": "\\b(?:nc|ncat|socat)\\b[^\\n]*(?:\\s(?:-e|--exec)\\b|\\b[0-9]{2,5}\\b)",
        "reason": "Netcat/socat to a host (reverse shell / data channel)"
      },
      {
        "pattern": "(?:^|\\n)(?:(?!\\b(?:curl|wget)\\b)[^\\n])*\\b(?:curl|wget)\\b(?:(?!(?:\\$\\(|`))[^\\n])*(?:\\$\\(|`)[^\\n]*(?:\\.env|id_rsa|id_ed25519|credentials|\\.pem|token|secret)",
        "reason": "Sending command-substituted secret material to a URL (exfiltration)"
      },
      {
        "pattern": "^(?=[\\s\\S]*(?:\\.claude|\\.mcp|claude_desktop_config)\\.json)(?=[\\s\\S]*\\bmcpServers\\b)[\\s\\S]*\\b(?:env|headers)\\b",
        "reason": "Reads an MCP server's credentials (env or headers) out of an MCP config file (~/.claude.json, .mcp.json, claude_desktop_config.json), into the shell or the transcript. If you did not ask for this, deny. Exits: allow rules in ~/.config/keel/policy.json"
      },
      {
        "pattern": "^(?:(?!(?:^|[\\s;&|(])(?:\\.|source)\\s+[\\\"']?[^\\s;&|]*?(?:secrets?|credentials?|creds?|tokens?|passwords?|api[-_]?keys?|\\.env(?:rc)?)\\b)[\\s\\S])*(?:^|[\\s;&|(])(?:\\.|source)\\s+[\\\"']?(?=(?<f>[^\\s;&|]*?(?:secrets?|credentials?|creds?|tokens?|passwords?|api[-_]?keys?|\\.env(?:rc)?)\\b))\\k<f>(?:[^\\n]*\\n)*?(?:[^\\n;&|]*[;&|])*?(?:(?!\\b(?:curl|wget)\\b)[^\\n;&|])*\\b(?:curl|wget)\\b(?:(?!(?:\\s-[a-z]*u(?=[\\s\\\"'$\\w])|\\s--user[\\s=]|--oauth2-bearer|\\b(?:authorization|proxy-authorization|x-api-key|api-?key|x-api-secret|x-auth-token|private-token|x-vault-token|cookie)\\s*:))[^\\n;&|])*(?:\\s-[a-z]*u(?=[\\s\\\"'$\\w])|\\s--user[\\s=]|--oauth2-bearer|\\b(?:authorization|proxy-authorization|x-api-key|api-?key|x-api-secret|x-auth-token|private-token|x-vault-token|cookie)\\s*:)",
        "reason": "Loads secrets from a file into the shell, then sends them with an authenticated request. Confirm the destination is one you meant"
      },
      {
        "pattern": "\\b(?:npx|bunx|pnpm\\s+dlx|yarn\\s+dlx)(?:\\s+-\\S+)*\\s+skills(?:@\\S+)?\\s+add\\b",
        "reason": "Installing a third-party Claude skill \u2014 review the source before allowing"
      },
      {
        "pattern": "\\bdocker(?:\\s+-\\S+)*\\s+compose\\b(?=([^\\n]*\\bconfig\\b))\\1(?![^\\n]*--quiet)",
        "reason": "Renders resolved compose config, interpolating every secret from .env into the output"
      },
      {
        "pattern": "(?<![\\w./~$\"'-])(?:printenv|env)\\s*(?:\\||>|$)|(?<=[\"'])(?<!(?:^|[;&|(\\n]|\\$\\()[ \\t]{0,16}(?:git[ \\t]{1,16})?(?:e?grep|fgrep|rg|ag|ack)\\b[^\\n;&|'\"]{0,200}(?<!\\\\)[\"'])(?:printenv|env)\\s*(?:\\||>|$)|(?<=[\"'])(?:printenv|env)(?:\\s*>|\\s*$|\\s+\\||\\|(?![^\\s|]))|(?<=(?:^|[;&|(`\\n{!]|\\$\\(|\\b(?:then|do|else|elif)\\b|\\b(?:sudo|doas|exec|command|nohup|time|timeout|nice|xargs|watch|eval|ssh|busybox)\\b[^\\n;&|]{0,64}?\\s)[ \\t]{0,16}['\"]?(?:/|~/|\\.\\.?/|\\$\\{?\\w{1,64}\\}?/)(?:[^\\s;&|<>'\"/]{0,64}/){0,16})(?:printenv|env)\\s*(?:\\||>|$)|(?<=\\bbin/)(?:printenv|env)\\s*(?:\\||>|$)",
        "reason": "May dump the whole environment, including any secrets in it: env or printenv right before |, > or the end, behind a wrapper (ssh, timeout, docker exec, a { } group), from a path, or as an argument"
      },
      {
        "pattern": "(?:(?<=\\b(?:cat|tac|less|more|head|tail|bat|nl|grep|egrep|fgrep|rg|ag|awk|sed|sort|uniq|cut|base64|xxd|od|hexdump|strings|diff|dd|tee|paste|column|fold|rev|tr|show|log|blame|sops|perl|ruby|iconv|fmt|pr|expand|look|xargs|vim?|view|nano|emacs)\\b[^\\n;&|]{0,400}[\\s/'\"=:])|(?<=<\\s{0,8}(?:['\"]?[^\\s;&|<>]{0,400}/|['\"])?))\\.env(?:\\.(?!(?:example|sample|template|dist)\\b)[\\w-]+)?(?=$|[\\s;&|>)'\"])",
        "reason": "Prints a .env file, whose values land in the transcript sent to the model provider"
      },
      {
        "pattern": "\\bfind\\b(?=[^\\n;&|]{0,200}\\.env\\b)[^\\n;&|]{0,400}?(?:-exec(?:dir)?\\s+(?:cat|head|tail|less|more|bat|grep|strings)\\b|\\|\\s*xargs\\s+(?:-\\S{1,32}\\s+){0,8}(?:cat|head|tail|less|more|bat|grep|strings)\\b)",
        "reason": "Prints .env files found by find, whose values land in the transcript sent to the model provider"
      },
      {
        "pattern": "\\bgit(?=(?<g>(?:\\s+(?:(?:-C|-c|--git-dir|--work-tree|--namespace|--super-prefix|--config-env|--attr-source|--shallow-file)\\s+(?:\\\"[^\\\"]*\\\"|'[^']*'|\\\\.|[^\\s\\\"'\\\\-])(?:\\\"[^\\\"]*\\\"|'[^']*'|\\\\.|[^\\s\\\"'\\\\])*|-{1,2}[^\\s=-][^\\s=]*(?:=(?:\\\"[^\\\"]*\\\"|'[^']*'|\\\\.|[^\\s\\\"'\\\\])*)?))*))\\k<g>\\s+config\\s+(?:--\\w+\\s+)*--list\\b",
        "reason": "Prints git config, which commonly carries tokens in remote URLs"
      },
      {
        "pattern": "\\bkubectl\\s+get\\s+secrets?\\b[^\\n]*-o\\s*(?:yaml|json)",
        "reason": "Prints secret values in full"
      },
      {
        "pattern": "(?:^|[|>;&])(?:(?!\\b(?:cat|less|more|head|tail|bat|strings|xxd|od|cp|dd|openssl|grep|awk|ln|link|install|mapfile)\\b)[^|>;&])*\\b(?:cat|less|more|head|tail|bat|strings|xxd|od|cp|dd|openssl|grep|awk|ln|link|install|mapfile)\\b(?:(?!\\.ssh/)[^|>;&]|\\.ssh/(?=(?<p>[\\w./-]*))\\k<p>(?!(?<=/id_[\\w.-]*)(?=[\\\"'\\s|;&)]|$)(?<!\\.pub)))*\\.ssh/(?=(?<k>[\\w./-]*))\\k<k>(?<=/id_[\\w.-]*)(?=[\\\"'\\s|;&)]|$)(?<!\\.pub)",
        "reason": "Renders or copies private key material \u2014 anything read into the transcript is sent to the model provider, and the only undo is rotation. If you did not ask for this, deny. Exits: allow rules in ~/.config/keel/policy.json"
      },
      {
        "pattern": "\\b(cat|less|more|head|tail|bat|strings|xxd|od|cp|dd|openssl|grep|awk|ln|link|install|mapfile)\\b[^|>;&]*(\\.aws/credentials|\\.credentials\\.json|private-keys-v1\\.d)",
        "reason": "Renders or copies credential material into the transcript, which is sent to the model provider. If you did not ask for this, deny. Exits: allow rules in ~/.config/keel/policy.json"
      },
      {
        "pattern": "\\b(tar|zip|7z|rsync|scp|sftp)\\b[^|;&]*\\.ssh(/|\\b)",
        "reason": "Archives or copies the .ssh directory \u2014 that ships private keys somewhere. If you did not ask for this, deny. Exits: allow rules in ~/.config/keel/policy.json"
      },
      {
        "pattern": "open\\s*\\(\\s*['\\\"](?:(?!\\.ssh/)[^'\\\"])*\\.ssh/(?=(?<s>[^'\\\"]*))\\k<s>(?<=/id_[^'\\\"/]*)(?<!\\.pub)['\\\"]",
        "reason": "An interpreter is reading private key material into the transcript, which is sent to the model provider \u2014 the only undo is rotation. If you did not ask for this, deny. Exits: allow rules in ~/.config/keel/policy.json"
      },
      {
        "pattern": "open\\s*\\(\\s*['\"][^'\"]*(\\.aws/credentials|\\.credentials\\.json)['\"]",
        "reason": "An interpreter is reading credential material into the transcript. If you did not ask for this, deny. Exits: allow rules in ~/.config/keel/policy.json"
      },
      {
        "pattern": "(?:^|[|&])(?:(?!\\b(?:node|deno|bun|python[0-9.]*|ruby|perl|php)\\b)[^|&])*\\b(?:node|deno|bun|python[0-9.]*|ruby|perl|php)\\b(?:(?!\\.ssh/)[^|&]|\\.ssh/(?=(?<p>[\\w./-]*))\\k<p>(?!(?<=/id_[\\w.-]*)(?=[\\\"'\\s|;&)]|$)(?<!\\.pub)))*\\.ssh/(?=(?<k>[\\w./-]*))\\k<k>(?<=/id_[\\w.-]*)(?=[\\\"'\\s|;&)]|$)(?<!\\.pub)",
        "reason": "An interpreter is reading private key material into the transcript, which is sent to the model provider \u2014 the only undo is rotation. If you did not ask for this, deny. Exits: allow rules in ~/.config/keel/policy.json"
      },
      {
        "pattern": "\\b(node|deno|bun|python[0-9.]*|ruby|perl|php)\\b[^|&]*(\\.aws/credentials|\\.credentials\\.json|private-keys-v1\\.d)",
        "reason": "An interpreter is reading credential material into the transcript. If you did not ask for this, deny. Exits: allow rules in ~/.config/keel/policy.json"
      }
    ],
    "alert": [
      {
        "pattern": "\\bsudo\\b",
        "reason": "Elevated privileges requested"
      }
    ]
  },
  "paths": {
    "zeroAccess": [
      "~/.ssh/id_*",
      "~/.ssh/**/id_*",
      "~/.ssh/*.pem",
      "~/.ssh/*.key",
      "~/.gnupg/private-keys-v1.d/**",
      "~/.aws/credentials",
      "~/.credentials.json"
    ],
    "readOnly": [],
    "confirmWrite": [
      "~/.ssh/**",
      "~/.aws/**",
      "~/.gnupg/**",
      "~/.claude/settings.json",
      "~/.config/keel/policy.json"
    ],
    "noDelete": [
      "~/.ssh/**",
      "~/.aws/**",
      "~/.gnupg/**",
      "~/.claude/settings.json"
    ],
    "allow": [
      "~/.ssh/*.pub",
      "~/.ssh/**/*.pub"
    ],
    "confirmRead": []
  }
}